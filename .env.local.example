# Dump Trade — local environment template
# Copy this file to `.env.local` and fill in your own values.
# The backend creates all tables + seed data automatically on the first
# request (api/_lib/schema.js), so you never write the schema by hand.

# Required: a Postgres connection string from Neon (https://neon.tech),
# Vercel Postgres, Supabase, etc. @vercel/postgres also accepts DATABASE_URL.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Optional: signs auth (JWT) tokens. Any random string is fine for local dev.
JWT_SECRET=change-me-to-anything

# Optional: only needed to enable image uploads (Vercel Blob).
# BLOB_READ_WRITE_TOKEN=
